# AI Sandbox Backend - Environment Configuration
# Copy this to .env and fill in values

# Application
APP_NAME=AI Sandbox Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sandbox:sandbox@localhost:5432/ai_sandbox
DATABASE_URL_SYNC=postgresql+psycopg2://sandbox:sandbox@localhost:5432/ai_sandbox

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://ai-sandbox.pages.dev"]

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Redis (for background jobs - Phase 2)
REDIS_URL=redis://localhost:6379/0

# LiteLLM (for endpoint validation - Phase 2)
LITELLM_API_BASE=http://localhost:4000

# Artifact Storage
ARTIFACT_STORAGE_PATH=./artifacts
